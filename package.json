{
  "name": "curationfig",
  "version": "1.0.0",
  "private": true,
  "description": "CurationFig — Editorial curation discovery for Film, TV, Games & Music",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/protect-generated.mjs && node scripts/gen-open-dataset.mjs write && next build && pagefind --site out",
    "start": "next start",
    "lint": "next lint",
    "search:index": "pagefind --site out",
    "fetch:music": "node scripts/fetch-musicbrainz.mjs",
    "fetch:games": "node scripts/fetch-steam.mjs",
    "fetch:tmdb": "node scripts/fetch-tmdb.mjs",
    "gen:music-seed": "node scripts/gen-music-seed.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "pagefind": "^1.5.2",
    "typescript": "5.5.3"
  }
}
